# =============================================================================
# DayZ Server Configuration
# =============================================================================

# User ID for file permissions (match your host user)
USER_ID=1000
GROUP_ID=1000

# API Configuration (internal, proxied by web)
API_PORT=8080
API_BIND_ADDRESS=127.0.0.1

# Web UI Configuration
WEB_PORT=8081

# API Authentication Token
# This token is used for both API access and Web UI login
# Generate a secure token: openssl rand -hex 32
API_TOKEN=your-secret-token-here

# Set to true to disable API authentication (NOT recommended for production)
API_AUTH_DISABLED=false

# Optional comma-separated browser origins for cross-origin API access.
# Same-origin access through the web proxy does not require CORS.
CORS_ORIGINS=

# Server Configuration
SERVER_PORT=2302
STEAM_QUERY_PORT=27016

# Set to 1 for experimental/unstable branch
EXPERIMENTAL=

# Docker Resource Limits (server container)
# SERVER_MEMORY_LIMIT=8g
# SERVER_CPU_LIMIT=4
# SERVER_MEMORY_RESERVE=4g

# Server startup parameters (optional, defaults are sensible)
# SERVER_PARAMS=-config=/profiles/serverDZ.cfg -port=2302 -BEpath=/profiles/battleye -profiles=/profiles -dologs -adminlog -netlog -freezecheck
